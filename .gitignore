
# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files - may contain passwords
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan

# Sensitive SSH private keys
*.pem
id_rsa
id_rsa.*

# Environment files
.env
.env.*